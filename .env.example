# Modèle documentaire uniquement : ./start.sh génère le fichier .env protégé.
# Mot de passe de la base PostgreSQL utilisée par Synapse
# Ne pas utiliser cette valeur littérale.
SYNAPSE_DB_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# Secret local utilisé uniquement pour créer le premier administrateur Synapse.
# Ne jamais le partager ni l'utiliser depuis un service exposé à Internet.
SYNAPSE_REGISTRATION_SHARED_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# Keycloak local : compte technique d'administration et secret OIDC Synapse.
# ./start.sh génère ces secrets localement ; ne pas utiliser ces placeholders.
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
SYNAPSE_OIDC_CLIENT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE
KIBARE_INITIAL_ADMIN_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
